APP_NAME="FP Corporativo"
APP_ENV=production            # Antes: local
APP_KEY=<ROTAR>               # php artisan key:generate --show
APP_DEBUG=false               # Antes: true (expone variables y trazas a cualquiera que provoque un error)
APP_URL=https://bot.fpcorporativo.com

TIMEZONE="America/Mexico_City"   # config/app.php lee TIMEZONE
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily               # Antes: single (un solo archivo que crece sin límite)
LOG_DAILY_DAYS=30
LOG_SECURITY_DAYS=90
LOG_LEVEL=info                # Antes: debug
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<conservar>
DB_USERNAME=<conservar>
DB_PASSWORD=<ROTAR>           # CloudPanel > Databases > Users

SESSION_DRIVER=database       # Antes: file (las sesiones del panel se perdían en cada deploy)
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# SMTP real: con MAIL_MAILER=log el bot NO emite códigos por correo (segundo factor).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@fpcorporativo.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=<ROTAR>                 # Token permanente de usuario de sistema (sin espacios alrededor del =)
WHATSAPP_PHONE_NUMBER_ID=<conservar>
WHATSAPP_API_VERSION=v22.0
WHATSAPP_VERIFY_TOKEN=<ROTAR>          # Cadena larga aleatoria; actualízala también en Meta
WHATSAPP_APP_SECRET=                   # NUEVO y obligatorio: Meta > App > Configuración > Básica
WHATSAPP_WELCOME_IMAGE_URL=https://bot.fpcorporativo.com/images/bot.png

# --- Seguridad del flujo de clientes ---
WHATSAPP_SESSION_TTL_MINUTES=15
WHATSAPP_RFC_MAX_ATTEMPTS=5
WHATSAPP_RFC_DECAY_MINUTES=60
WHATSAPP_OTP_TTL_MINUTES=10
WHATSAPP_OTP_MAX_ATTEMPTS=3
WHATSAPP_OTP_MAX_PER_DAY=3
WHATSAPP_OTP_VIA_EMAIL=true
WHATSAPP_OTP_TEMPLATE=                 # Plantilla "Autenticación" aprobada en Meta (opcional)
WHATSAPP_OTP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_DOWNLOAD_LINK_TTL_MINUTES=10

# --- Gemini (modo agente) ---
GEMINI_API_KEY=<ROTAR>                 # Revoca también la key antigua comentada
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Eliminadas por no usarse: URL_TEMP, WHATSAPP_DOCUMENT_BASE_URL, PHP_CLI_SERVER_WORKERS, AWS_*, REDIS_*, MEMCACHED_*
